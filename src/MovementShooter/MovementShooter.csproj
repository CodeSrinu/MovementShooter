<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MovementShooter</RootNamespace>
    <AssemblyName>MovementShooter</AssemblyName>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <Product>KINETIC</Product>
    <AssemblyTitle>KINETIC</AssemblyTitle>
    <Description>A fast-paced, skill-based 3D movement shooter built on C# and MonoGame.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The character asset, generated at build time by tools\KineticAssetTool from
      KINETIC_Character.glb. Embedded rather than read from disk so the game has no
      asset path to resolve and works from any working directory.

      LogicalName is set explicitly because the default would be
      "MovementShooter.Assets.Models.KINETIC_Character.bin", which breaks silently
      whenever the file moves. CharacterAsset.ResourceName must match this.
    -->
    <EmbeddedResource Include="Assets\Models\KINETIC_Character.bin"
                      LogicalName="KINETIC_Character.bin" />
    <!-- The weapon is a separate asset from the character: rigid geometry, no skin, no
         animation, attached at runtime through the character's socket system. -->
    <EmbeddedResource Include="Assets\Models\KINETIC_RocketLauncher.bin"
                      LogicalName="KINETIC_RocketLauncher.bin" />
    <!-- The first-person arms. Authored in the launcher's own space - grip at the origin,
         barrel along +Z - so the launcher and the arms are drawn with a single transform.
         A separate asset because the launcher is shared with the third-person character,
         and viewmodel geometry must not appear on a remote character. -->
    <EmbeddedResource Include="Assets\Models\KINETIC_FPSArms.bin"
                      LogicalName="KINETIC_FPSArms.bin" />
  </ItemGroup>

</Project>