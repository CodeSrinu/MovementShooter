# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
artifacts/

# Runtime output written by the game itself (logs/, self-test screenshots)
[Ll]og/
[Ll]ogs/
*.log

# ---------------------------------------------------------------------------
# MonoGame content pipeline output (.xnb files are compiled assets)
# ---------------------------------------------------------------------------
*.xnb
Content/[Bb]in/
Content/[Oo]bj/

# ---------------------------------------------------------------------------
# Blender
# ---------------------------------------------------------------------------
# *.blend source scenes and *.glb exports are tracked deliberately - they are
# authored assets, not build output. Only Blender's own generated siblings are
# ignored below.
#
# "Save Versions" backups: foo.blend1 .. foo.blend9. Matching a trailing digit
# instead of listing each suffix keeps this correct regardless of how many save
# versions are configured, and cannot swallow a real ".blend".
*.blend[0-9]

# Written when Blender is configured to save on quit.
quit.blend

# ---------------------------------------------------------------------------
# NuGet
# ---------------------------------------------------------------------------
*.nupkg
*.snupkg
packages/
.nuget/
*.nuget.props
*.nuget.dgspec.json
*.nuget.g.props
*.nuget.g.targets

# ---------------------------------------------------------------------------
# IDE files (shared settings only; user-specific state is ignored)
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
_ReSharper*/

# Editor and merge leftovers
*~
*.bak
*.orig
*.rej
*.swp
*.swo
.*.sw[a-z]
.history/

# ---------------------------------------------------------------------------
# Test / coverage / profiling output
# ---------------------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]enchmark[Rr]esult*/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# ---------------------------------------------------------------------------
# Debugging symbols and crash dumps
# ---------------------------------------------------------------------------
*.pdb
*.mdb
*.dmp
*.mdmp

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_v2.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
*.lnk
nohup.out

# ---------------------------------------------------------------------------
# Secrets and local machine settings
# ---------------------------------------------------------------------------
*.env
.env
.env.*
!.env.example
*.pfx
*.snk
*.keystore
secrets.json