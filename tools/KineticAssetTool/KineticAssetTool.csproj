<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time asset tool. Deliberately NOT referenced by MovementShooter.sln:
    it is a one-shot generator, not part of the game, and keeping it out of the
    solution means a tool failure can never break the main solution build.

    Run it from the repository root, passing the input .glb and the output .bin
    as arguments; see the tool's own help text for the exact flags.

    It has no package references on purpose. MonoGame has no glTF importer, and
    the alternative - a glTF library - would put a large dependency in the tree
    to read a 400 KB file with four known accessors. This parser is the whole
    cost of doing that without one.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>KineticAssetTool</RootNamespace>
    <AssemblyName>KineticAssetTool</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

</Project>
